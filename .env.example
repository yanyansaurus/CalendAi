# ─── Google OAuth + Calendar ──────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → new project
# 2. Enable "Google Calendar API"
# 3. OAuth consent screen → add scope: https://www.googleapis.com/auth/calendar
# 4. Create OAuth 2.0 Client ID (Web) → add redirect URI:
#    http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Zoom Server-to-Server OAuth ──────────────────────────────────────────────
# 1. Go to https://marketplace.zoom.us → Build App → Server-to-Server OAuth
# 2. Add scopes: meeting:write:admin
# 3. Copy Account ID, Client ID, and Client Secret
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Vercel KV ────────────────────────────────────────────────────────────────
# Vercel Dashboard → Storage → Create KV database → copy env vars
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
